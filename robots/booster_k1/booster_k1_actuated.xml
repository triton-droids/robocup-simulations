<mujoco model="booster_k1_actuated">
  <include file="booster_k1.xml" />
  <!-- Empty on purpose: ProtoMotions' MuJoCo loader only edits this top-level file and adds
       its floor and light into the <worldbody> it finds here. MuJoCo merges it with the
       included one. scene.xml adds the floor for standalone viewing instead. -->
  <worldbody />
  <!-- Booster's simulation defaults, derived from the joint armatures as in BoosterRobotics/booster_train
       (kp = armature * (2*pi*f)^2, kv = 2 * zeta * armature * 2*pi*f; legs f = 4 Hz, arms and head
       f = 10 Hz). ProtoMotions ignores these values and uses robocup_rl/robots/booster_k1.py, which
       derives the same numbers; a test keeps the two equal. Not verified hardware specifications. -->
  <actuator>
    <position name="aahead_yaw_act" joint="aahead_yaw_joint" kp="3.9478" kv="0.2513" forcelimited="true" forcerange="-6 6" />
