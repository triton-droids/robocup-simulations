# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# colcon, if the packages are built in place
build/
install/
log/

# Local virtualenvs (see README)
.venv*/

# Generated by test_report/make_results.py and visual_only.py (the HTML pages are committed snapshots)
test_report/raw/

# Bench recordings and outputs (python -m td_bench --record runs/... --out reports/...)
runs/
*.npz

# Evaluation outputs. Only the two reference suite summaries are committed; the CSVs are regenerated with
# python -m td_localization.eval suite --out reports/<name>
reports/*
!reports/suite_m_default_seed1/
!reports/suite_m_harsh_seed1/
reports/suite_m_*_seed1/*
!reports/suite_m_*_seed1/report.md
!reports/suite_m_*_seed1/results.json
