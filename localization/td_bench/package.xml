<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>td_bench</name>
  <version>0.1.0</version>
  <description>Bench testing of localization with any mix of real, recorded and simulated inputs.</description>
  <maintainer email="parthtttrivedi@gmail.com">Triton Droids Perception</maintainer>
  <license>MIT</license>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>td_field_model</exec_depend>
  <exec_depend>td_localization</exec_depend>
  <exec_depend>td_game</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
